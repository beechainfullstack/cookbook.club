# SERVER ONLY. Copy to .env.local (ignored), never to EXPO_PUBLIC_* variables.
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected by Supabase Edge Runtime.
# For standalone local scripts only, obtain these from `npx supabase status`.
ANTHROPIC_API_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL=Slow <notes@your-verified-domain.example>
ADMIN_ALERT_EMAIL=you@example.com
MONTHLY_LLM_BUDGET_USD=10
# Generate two DIFFERENT random secrets, each at least 32 characters.
SLOW_JOB_SECRET=
FEEDBACK_SIGNING_SECRET=
# URL of the exported Expo web app, for login-free email feedback.
FEEDBACK_WEB_URL=http://localhost:8081
# Optional, if Expo enhanced push security is enabled. Not an EAS CLI login token.
EXPO_ACCESS_TOKEN=
