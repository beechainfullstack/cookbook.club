{
  "name": "slow",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "typecheck:edge": "deno task --config supabase/functions/deno.json check",
    "lint:edge": "deno task --config supabase/functions/deno.json lint",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:db": "supabase test db",
    "test:integration": "node scripts/verify-phase-one.mjs",
    "test:weekly": "node --experimental-strip-types scripts/verify-phase-two.ts",
    "build:mobile": "expo export --platform ios --platform android",
    "build:web": "expo export --platform web",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset --local"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.57.4",
    "expo": "~54.0.36",
    "expo-crypto": "~15.0.9",
    "expo-constants": "~18.0.14",
    "expo-dev-client": "~6.0.21",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-linking": "~8.0.12",
    "expo-notifications": "~0.32.17",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "eslint": "^9.39.1",
    "eslint-config-expo": "^10.0.0",
    "supabase": "2.120.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
