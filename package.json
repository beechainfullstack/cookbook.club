{
  "name": "cookbook-club",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:db": "supabase test db",
    "check:worker": "deno check --no-config --node-modules-dir=none supabase/functions/dispatch-reveals/index.ts",
    "copy:sync": "node scripts/sync-copy.mjs",
    "db:start": "npm run copy:sync && supabase start",
    "build:web": "expo export --platform web",
    "build:mobile": "expo export --platform ios --platform android"
  },
  "dependencies": {
    "@expo-google-fonts/dm-sans": "^0.4.2",
    "@expo-google-fonts/fraunces": "^0.4.1",
    "@expo/config-plugins": "~57.0.0",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-community/datetimepicker": "9.1.0",
    "@supabase/supabase-js": "^2.95.3",
    "expo": "~57.0.23",
    "expo-constants": "~57.0.18",
    "expo-contacts": "~57.0.5",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-font": "~57.0.4",
    "expo-notifications": "~57.0.19",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "libphonenumber-js": "^1.12.37",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/react": "~19.2.4",
    "deno": "2.5.6",
    "eslint": "^9.39.1",
    "eslint-config-expo": "~57.0.2",
    "supabase": "^2.117.0",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11"
  }
}
