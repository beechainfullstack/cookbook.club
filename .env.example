# Client-safe configuration only. Never put a service-role or secret key here.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-anon-or-hosted-publishable-key
# Optional. Leave empty for auto-detected Expo Go / native / web callback.
# Native development builds use slow://auth/callback.
EXPO_PUBLIC_AUTH_REDIRECT_URL=

# Reserved for Phase 2 SERVER-SIDE configuration. Not consumed in Phase 1.
# MONTHLY_LLM_BUDGET_USD=10
